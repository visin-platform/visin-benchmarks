{
  "extends": "clftv2",
  "Summary": "ZOD LiDAR CLFTv2-Tiny",
  "tags": ["zod", "clftv2-tiny", "lidar"],
  "CLI": {"mode": "lidar"},
  "Dataset": {
    "dataset_root": "data/zod",
    "annotation_path": "annotation_camera_only"
  },
  "Log": {"logdir": "logs/zod/clftv2-tiny/lidar"},
  "General": {
    "device": "cuda:0",
    "epochs": 200,
    "batch_size": 8,
    "seed": 0,
    "precision": "bf16",
    "early_stop_patience": 200,
    "max_checkpoints": 1,
    "publish_model": "visin",
    "model_license": "cc-by-sa-4.0",
    "model_credit": "Zenseact Open Dataset (ZOD), Zenseact AB"
  },
  "CLFTv2": {
    "model_timm": "swinv2_tiny_window16_256",
    "emb_dims": [96, 192, 384, 768],
    "clft_lr": 4e-05,
    "pretrained": true
  }
}
