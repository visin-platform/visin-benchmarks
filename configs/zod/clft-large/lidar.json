{
  "extends": "clft",
  "Summary": "ZOD LiDAR CLFT-Large",
  "tags": ["zod", "clft-large", "lidar"],
  "CLI": {"mode": "lidar"},
  "Dataset": {
    "dataset_root": "data/zod",
    "annotation_path": "annotation_camera_only"
  },
  "Log": {"logdir": "logs/zod/clft-large/lidar"},
  "General": {
    "device": "cuda:0",
    "epochs": 300,
    "batch_size": 8,
    "seed": 0,
    "early_stop_patience": 300,
    "max_checkpoints": 1,
    "publish_model": "visin",
    "model_license": "cc-by-sa-4.0",
    "model_credit": "Zenseact Open Dataset (ZOD), Zenseact AB"
  },
  "CLFT": {
    "model_timm": "vit_large_patch16_384",
    "emb_dim": 1024,
    "hooks": [5, 11, 17, 23],
    "clft_lr": 8e-05,
    "pretrained": true
  }
}
