{
  "extends": "clft",
  "Summary": "iSeAuto LiDAR CLFT-Base",
  "tags": ["iseauto", "clft-base", "lidar"],
  "CLI": {"mode": "lidar"},
  "Dataset": {
    "dataset_root": "data/iseauto",
    "annotation_path": "annotation"
  },
  "Log": {"logdir": "logs/iseauto/clft-base/lidar"},
  "General": {
    "device": "cuda:0",
    "epochs": 300,
    "batch_size": 8,
    "seed": 0,
    "early_stop_patience": 300,
    "max_checkpoints": 1,
    "publish_model": "visin",
    "model_license": "cc-by-4.0",
    "model_credit": "iseAuto dataset, Tallinn University of Technology (TalTech)"
  },
  "CLFT": {
    "model_timm": "vit_base_patch16_384",
    "clft_lr": 8e-05,
    "pretrained": true
  }
}
