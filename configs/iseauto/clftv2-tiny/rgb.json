{
  "extends": "clftv2",
  "Summary": "iSeAuto RGB CLFTv2-Tiny",
  "tags": ["iseauto", "clftv2-tiny", "rgb"],
  "CLI": {"mode": "rgb"},
  "Dataset": {
    "dataset_root": "data/iseauto",
    "annotation_path": "annotation"
  },
  "Log": {"logdir": "logs/iseauto/clftv2-tiny/rgb"},
  "General": {
    "device": "cuda:0",
    "epochs": 200,
    "batch_size": 8,
    "seed": 0,
    "precision": "bf16",
    "early_stop_patience": 200,
    "max_checkpoints": 1,
    "publish_model": "visin",
    "model_license": "cc-by-4.0",
    "model_credit": "iseAuto dataset, Tallinn University of Technology (TalTech)"
  },
  "CLFTv2": {
    "model_timm": "swinv2_tiny_window16_256",
    "emb_dims": [96, 192, 384, 768],
    "clft_lr": 4e-05,
    "pretrained": true
  }
}
