# Copy to .env (git-ignored); train.py reads it. Variables already exported win.

# A pipeline key limited to the project the runs should land in (Visin: project Settings -> Pipeline keys).
VISIN_URL=https://vision-api.visin.eu
VISIN_DATASET_URL=https://dataset-api.visin.eu
VISIN_TOKEN=

# Where datasets are unpacked (default ~/.cache/visin/datasets; data/<dataset> links to them).
# On a cluster, somewhere with room: about 20 GB for all three.
# VISIN_DATA_DIR=/scratch/you/visin-data

# Where pretrained backbones are cached (default ~/.cache/huggingface), about 3 GB for all six.
# HF_HOME=/scratch/you/hf

# For compute nodes without a route to Visin: reports and the checkpoint upload wait on disk in VISIN_DIR
# (default ~/.visin); run `visin sync` on a node that can reach Visin to send them.
# VISIN_MODE=offline
# VISIN_DIR=/scratch/you/visin-queue
